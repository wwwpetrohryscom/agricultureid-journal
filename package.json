{
  "name": "agricultureid-journal",
  "version": "1.0.0",
  "private": true,
  "description": "AgricultureID Journal — evidence-based reporting, research, data, markets and agricultural intelligence.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:journal && tsx scripts/build-indexes.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:journal": "tsx scripts/validate-journal.ts",
    "validate:seo": "tsx scripts/validate-seo.ts",
    "validate:routing": "tsx scripts/validate-routing.ts",
    "validate": "npm run format:check && npm run typecheck && npm run lint && npm run validate:journal && npm run build && npm run validate:seo && npm run validate:routing",
    "test": "vitest run"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  }
}
